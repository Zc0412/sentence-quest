{
  "name": "sentence-quest",
  "private": true,
  "version": "2.2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "typecheck": "npm --prefix web run typecheck",
    "check:data": "npm --prefix web run check:data",
    "check": "npm --prefix web run check && npm run typecheck:miniprogram && npm run test:miniprogram && npm run test:dictionary-upload",
    "test:notebook": "npm --prefix web run test:notebook",
    "test:selection": "npm --prefix web run test:selection",
    "test:review": "npm --prefix web run test:review",
    "test:smoke": "npm --prefix web run test:smoke",
    "test:storage": "npm --prefix web run test:storage",
    "test:feedback": "npm --prefix web run test:feedback",
    "test:id": "npm --prefix web run test:id",
    "test:history": "npm --prefix web run test:history",
    "sync:miniprogram": "node --import tsx scripts/sync-miniprogram.mts",
    "upload:dictionary": "node --import tsx scripts/upload-cloud-dictionary.ts",
    "test:dictionary-upload": "node --import tsx --test scripts/test-cloud-dictionary-upload.ts",
    "test:miniprogram": "node --import tsx scripts/test-miniprogram.ts",
    "test:pwa": "npm --prefix web run test:pwa",
    "typecheck:miniprogram": "tsc -p miniprogram/tsconfig.json && tsc -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@cloudbase/node-sdk": "^3.18.7",
    "@types/node": "^22.20.5",
    "miniprogram-api-typings": "^5.2.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
