{
  "name": "sentence-quest",
  "private": true,
  "version": "2.2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "typecheck": "npm --prefix web run typecheck",
    "check:data": "npm --prefix web run check:data",
    "check": "npm --prefix web run check && npm run test:miniprogram",
    "test:notebook": "npm --prefix web run test:notebook",
    "test:selection": "npm --prefix web run test:selection",
    "test:review": "npm --prefix web run test:review",
    "test:smoke": "npm --prefix web run test:smoke",
    "test:storage": "npm --prefix web run test:storage",
    "test:feedback": "npm --prefix web run test:feedback",
    "test:id": "npm --prefix web run test:id",
    "test:history": "npm --prefix web run test:history",
    "sync:miniprogram": "node scripts/sync-miniprogram.mjs",
    "test:miniprogram": "node scripts/test-miniprogram.cjs"
  }
}
