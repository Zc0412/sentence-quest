# 本地开发配置；真实密码只填写到 .env，不要提交。
PORT=8080

# 云托管 MySQL：填写可从当前电脑访问的数据库地址。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=sentleap

# 云存储环境 ID，与 MySQL 配置独立。
CLOUDBASE_ENV_ID=
# 本地访问云存储时填写具备所需权限的凭据。
CLOUDBASE_APIKEY=

# 管理接口令牌：至少 32 字符的随机值；留空时禁用管理操作。
DICTIONARY_ADMIN_TOKEN=
