# 本地开发配置；真实密码只填写到 .env，不要提交。
PORT=8080

# 云托管 MySQL：填写可从当前电脑访问的数据库地址。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=sentleap

# 微信云托管环境及对象存储配置（在云托管控制台-对象存储-存储配置查看）。
WX_CLOUD_ENV_ID=
COS_BUCKET=
COS_REGION=ap-shanghai

# 后台会话有效期（1–30 天）；浏览器来源须明确列入白名单，不带尾斜杠。
ADMIN_SESSION_DAYS=7
ADMIN_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
