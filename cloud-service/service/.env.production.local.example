# 仅用于非容器生产运行：复制为 .env.production.local 并在服务器填写。
# 云托管直接在平台注入这些变量，不把此文件复制到镜像。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=sentleap
# MYSQL_SSL_CA=可信 CA PEM（需要 TLS 时配置，不关闭证书验证）
WX_CLOUD_ENV_ID=
COS_BUCKET=
COS_REGION=ap-shanghai
ADMIN_SESSION_DAYS=7
# 替换为实际后台 HTTPS 来源，不带 /admin 路径或尾斜杠。
ADMIN_ALLOWED_ORIGINS=https://admin.example.com
