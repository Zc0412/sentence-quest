{
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "name": "sentleap-cloud-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:setup": "node --env-file=.env --import tsx scripts/create-database.ts && npm run db:migrate",
    "admin:init": "node --env-file=.env --import tsx scripts/admin-account.ts init",
    "admin:reset-password": "node --env-file=.env --import tsx scripts/admin-account.ts reset-password",
    "admin:cleanup": "node --env-file=.env --import tsx scripts/admin-account.ts cleanup"
  }
}
