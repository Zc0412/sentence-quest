@import '../../styles/glass.wxss';
.practice { position:fixed; inset:0; min-height:0; }.practice-shell { position:relative; height:100%; display:flex; flex-direction:column; }.status-space { flex-shrink:0; }.practice .glass-nav { font-size:16px; font-weight:700; padding-left:10px; }.glass-nav .back-button { flex:0 0 30px; width:30px; height:36px; background:transparent; color:#0f172a; font-size:32px; font-weight:400; line-height:32px; }.practice-scroll { flex:1; min-height:0; height:0; }.practice-tools { display:flex; align-items:center; gap:8px; padding:4px 16px 0; }.accent-switch { flex:0 0 110px; width:110px; height:32px; border-radius:16px; display:flex; padding:2px; }.accent-switch .accent-button { flex:1 1 0%; width:0; height:26px; padding:0; display:flex; align-items:center; justify-content:center; border-radius:13px; background:transparent; color:#475569; font-size:13px; font-weight:400; }.accent-switch .accent-button.selected { background:#fff; color:#2f6fed; font-weight:700; box-shadow:0 1px 4px #3250a033; }.practice-xp { display:flex; align-items:center; gap:4px; height:32px; padding:0 12px; border-radius:16px; font-size:14px; font-weight:800; }.practice-xp>text:first-child { color:#f59e0b; font-size:20px; }.practice-xp .xp-unit { color:#475569; font-size:12px; font-weight:500; }.practice-tools .help-button { flex:0 0 32px; width:32px; height:32px; margin-left:auto; border-radius:16px; font-size:18px; color:#2f6fed; }.mastery { padding:12px 20px 0; }.mastery-label { display:flex; justify-content:space-between; gap:8px; color:#475569; font-size:12px; }.mastery-label view text { color:#2f6fed; font-weight:800; }.mastery-track { height:6px; margin-top:6px; border-radius:3px; overflow:hidden; background:rgba(255,255,255,.6); }.mastery-track>view { height:100%; background:linear-gradient(90deg,#4f86f7,#2f6fed); border-radius:3px; }
.exercise-card { margin:12px 16px 0; padding:18px 14px 14px; border-radius:28px; background:rgba(255,255,255,.45); }.prompt-label { text-align:center; font-size:11px; letter-spacing:2px; color:#475569; font-weight:600; }.prompt { text-align:center; font-size:24px; font-weight:800; line-height:1.4; margin-top:6px; overflow-wrap:anywhere; }.letter-board { display:flex; flex-wrap:wrap; justify-content:center; gap:8px 12px; margin-top:16px; }.word-group { max-width:100%; padding:2px 3px; }.word-phonetic { color:#475569; font-size:11px; height:15px; white-space:nowrap; }.word-letters { display:flex; flex-wrap:wrap; gap:2px; }.letter { width:17px; height:30px; border:1px solid rgba(255,255,255,.9); border-radius:7px; background:rgba(255,255,255,.4); text-align:center; font-size:17px; font-weight:700; line-height:27px; color:#0f172a; }.letter.filled { background:rgba(255,255,255,.75); }.letter.passed { color:#16a36b; }.letter.current { border:2px solid #2f6fed; line-height:25px; }.letter.hinted { color:#94a3b8; }.letter.wrong { color:#c2410c; background:#ffedd5; border-color:#fb923c; }.typing-feedback { margin-top:10px; text-align:center; font-size:11px; color:#475569; overflow-wrap:anywhere; }.typing-feedback.error { color:#c2410c; }.exercise-actions { display:flex; gap:8px; margin-top:16px; }.exercise-actions .glass-action { flex:1 1 0%; width:0; height:44px; padding:0 3px; border:1px solid rgba(255,255,255,.85); border-radius:14px; background:rgba(255,255,255,.55); color:#2f6fed; font-size:13px; font-weight:700; display:flex; align-items:center; justify-content:center; }.sentence-navigation { display:flex; justify-content:space-between; gap:10px; margin-top:10px; }.sentence-navigation .sentence-link { background:transparent; color:#2f6fed; font-size:12px; font-weight:400; line-height:22px; flex-shrink:0; }.sentence-navigation .previous { flex:1; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.typing-stats { display:flex; margin:10px 16px 14px; padding:8px; border-radius:16px; background:rgba(255,255,255,.35); }.typing-stats>view { flex:1; min-width:0; text-align:center; }.typing-stats text { font-size:12px; color:#475569; }.typing-stats>view>view { font-size:22px; font-weight:800; }.typing-stats .correct-count { color:#16a36b; }
.glass-keyboard { flex-shrink:0; padding:14px 4px calc(18px + env(safe-area-inset-bottom)); border-radius:28px 28px 0 0; border-bottom:0; background:rgba(255,255,255,.4); display:flex; flex-direction:column; gap:10px; }.keyboard-row { display:flex; justify-content:center; gap:6px; }.keyboard-row .keyboard-key { flex:0 1 34px; width:34px; height:44px; padding:0; border-radius:9px; background:rgba(255,255,255,.7); box-shadow:0 1px 3px #3250a033,inset 0 1px 0 #fff; font-size:18px; font-weight:400; color:#0f172a; line-height:44px; }.keyboard-row .special { flex-basis:46px; width:46px; color:#475569; }.keyboard-key.uppercase { text-transform:uppercase; }.keyboard-row .shift-active { background:#dbeafe; color:#2f6fed; }
.completion { text-align:center; margin-top:12px; }.completion-reward { color:#16a36b; font-weight:800; }.answer { margin-top:8px; color:#475569; font-size:14px; overflow-wrap:anywhere; }.grammar-explanation { margin-top:16px; padding-top:12px; border-top:1px solid #ffffffaa; }.grammar-title { font-size:13px; font-weight:700; }.grammar-tabs { margin-top:8px; white-space:nowrap; }.grammar-tabs .grammar-tab { display:inline-block; width:auto; padding:6px 10px; border-radius:8px; background:transparent; color:#475569; font-size:12px; }.grammar-tabs .selected { background:#ffffffb3; color:#2f6fed; }.grammar-note { font-size:12px; color:#475569; line-height:1.8; margin-top:8px; }.state-card { margin:16px; padding:32px 20px; border-radius:28px; text-align:center; }.state-card .glass-primary { width:100%; height:44px; margin-top:20px; background:linear-gradient(135deg,#4f86f7,#2f6fed); color:#fff; border-radius:22px; }.state-card .glass-action { width:100%; height:44px; margin-top:12px; background:#ffffff99; color:#2f6fed; border-radius:22px; }.finish-icon { font-size:40px; color:#16a36b; }.finish-title { margin-top:12px; font-size:22px; font-weight:800; }.finish-note { margin-top:8px; font-size:13px; color:#475569; }
@media (max-width:350px) { .exercise-card { margin-left:12px; margin-right:12px; padding:16px 10px 12px; }.prompt { font-size:21px; }.keyboard-row { gap:4px; }.exercise-actions .glass-action { font-size:12px; } }

.practice-xp .xp-icon { width:16px; height:16px; flex-shrink:0; }.exercise-actions .action-icon { width:17px; height:17px; margin-right:5px; flex-shrink:0; }
