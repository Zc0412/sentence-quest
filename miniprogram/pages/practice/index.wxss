.practice { position:fixed; top:0; left:0; right:0; display:flex; flex-direction:column; background:#f6f8fc; }
.progress-head { padding:24rpx 32rpx 12rpx; flex-shrink:0; color:#64748b; font-size:24rpx; }.track { height:8rpx; border-radius:8rpx; background:#e2e8f0; margin-top:20rpx; overflow:hidden; }.fill { height:100%; background:#3b82f6; }
.exercise-scroll { flex:1; height:0; min-height:0; }.exercise { padding:32rpx; text-align:center; }.prompt { font-size:42rpx; font-weight:750; line-height:1.5; margin:24rpx 0; overflow-wrap:break-word; }
.slots { display:flex; flex-wrap:wrap; justify-content:center; gap:14rpx; margin:28rpx 0; }.slot { font-size:30rpx; padding:10rpx 18rpx; border-radius:14rpx; background:#eaf0f8; color:#94a3b8; overflow-wrap:anywhere; }.slot.active { background:#dbeafe; color:#2563eb; }.slot.passed { background:#e7f7ef; color:#15803d; }
.input-dock { flex-shrink:0; background:white; padding:20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; box-shadow:0 -6rpx 30rpx #17243b08; }.input-dock.keyboard-open { padding-bottom:16rpx; }
.phonetic { color:#64748b; font-size:25rpx; text-align:center; min-height:32rpx; margin-bottom:8rpx; }.word-input { height:96rpx; width:100%; padding:12rpx 24rpx; border:3rpx solid #93b9fc; border-radius:22rpx; background:#f8fbff; text-align:center; font-size:48rpx; color:#1d4ed8; }.word-input.invalid { border-color:#fb923c; color:#c2410c; }
.feedback { color:#718096; font-size:23rpx; text-align:center; margin:12rpx 0; overflow-wrap:anywhere; }.feedback.error { color:#c2410c; }.actions { display:flex; gap:16rpx; }.actions button { flex:1; line-height:88rpx; min-height:88rpx; }
.answer { color:#2563eb; font-size:46rpx; line-height:1.5; overflow-wrap:anywhere; }.reward { color:#15803d; margin:24rpx 0; font-weight:700; }.explanation,.grammar { text-align:left; padding:24rpx; background:white; border-radius:20rpx; margin-top:20rpx; line-height:1.7; }
@media (max-height:600px) { .exercise { padding-top:16rpx; }.prompt { margin:12rpx 0; font-size:36rpx; }.slots { margin:18rpx 0; } }
