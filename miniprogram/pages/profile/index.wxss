.stats { text-align:center; }.stats text { font-size:44rpx; font-weight:800; color:#2563eb; }.calendar { display:grid; grid-template-columns:repeat(7,1fr); gap:12rpx; }.day { background:#eff3f8; color:#94a3b8; border-radius:12rpx; text-align:center; line-height:64rpx; }.day.active { background:#bfdbfe; color:#1d4ed8; }.chosen { background:#2563eb; color:white; }
