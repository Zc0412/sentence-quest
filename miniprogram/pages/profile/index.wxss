@import '../../styles/glass.wxss';
.profile-page { overflow:hidden; padding-bottom:calc(110px + env(safe-area-inset-bottom)); }.profile-content { display:flex; flex-direction:column; gap:12px; padding:8px 16px; }.identity-card { padding:16px 16px 14px; border-radius:28px; background:rgba(255,255,255,.45); -webkit-backdrop-filter:blur(24px) saturate(170%); backdrop-filter:blur(24px) saturate(170%); }
.identity-row { display:flex; align-items:center; gap:14px; }
.avatar { box-sizing:border-box; flex:none; width:68px; height:68px; padding:3px; border-radius:50%; background:linear-gradient(135deg,#4f86f7,#b197fc,#6ee7d2); }
.avatar-inner { box-sizing:border-box; width:100%; height:100%; display:flex; align-items:center; justify-content:center; border:2px solid #fff; border-radius:50%; background:linear-gradient(135deg,#c9dbff,#dccfff); }
.avatar image { width:30px; height:30px; }.identity-copy { flex:1; min-width:0; }.nickname { width:100%; height:28px; font-size:20px; font-weight:800; color:#0f172a; background:transparent; padding:0; }.nickname-placeholder { color:#0f172a; }
.streak { display:inline-flex; align-items:center; gap:4px; margin-top:5px; padding:3px 10px 3px 8px; border:1px solid rgba(255,255,255,.7); border-radius:12px; background:rgba(245,158,11,.18); font-size:12px; font-weight:700; color:#92400e; }.streak image { width:13px; height:13px; }
.identity-copy .user-id { display:flex; align-items:center; justify-content:flex-start; gap:6px; max-width:100%; margin-top:3px; background:transparent; color:#475569; font-size:12px; line-height:1.4; text-align:left; }.user-id-value { color:#0f172a; font-weight:700; letter-spacing:.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.user-id image { width:13px; height:13px; flex:none; }
.identity-stats { display:flex; align-items:stretch; margin-top:16px; padding:12px 0; border:1px solid rgba(255,255,255,.85); border-radius:20px; background:rgba(255,255,255,.55); box-shadow:inset 0 1px 0 #fff; }.identity-stat { box-sizing:border-box; flex:1; min-width:0; padding:0 4px; text-align:center; }.identity-stat + .identity-stat { border-left:1px solid rgba(148,163,184,.35); }
.stat-label { display:flex; align-items:center; justify-content:center; gap:4px; font-size:12px; color:#475569; }.stat-label image { width:14px; height:14px; }.stat-value { margin-top:6px; font-size:24px; font-weight:800; line-height:1; overflow-wrap:anywhere; }.stat-value text { margin-left:2px; font-size:12px; font-weight:700; }.xp-stat .stat-value { color:#78350f; }.xp-stat .stat-value text { color:#d97706; }.mastered-stat .stat-value { color:#2f6fed; }

.settings-card { border-radius:22px; overflow:hidden; }.settings-card .setting-row { width:100%; min-width:0; height:54px; margin:0; padding:0 16px; box-sizing:border-box; display:flex; align-items:center; gap:12px; border-radius:0; background:transparent; border-bottom:1rpx solid rgba(255,255,255,.7); color:#0f172a; text-align:left; font-weight:400; line-height:1.4; }.settings-card .setting-row:last-child { border-bottom:0; }.setting-icon { width:30px; height:30px; border-radius:9px; background:rgba(255,255,255,.7); display:flex; align-items:center; justify-content:center; flex-shrink:0; }.setting-icon image { width:17px; height:17px; }.setting-title { flex:1; min-width:0; font-size:15px; font-weight:600; }.setting-value { display:flex; align-items:center; gap:8px; color:#475569; font-size:14px; flex-shrink:0; }.setting-chevron { width:8px; height:8px; margin-right:3px; border-top:1.5px solid #475569; border-right:1.5px solid #475569; transform:rotate(45deg); flex-shrink:0; }.accent-toggle { display:flex; padding:2px; border-radius:14px; background:rgba(255,255,255,.5); width:106px; flex:0 0 106px; height:30px; }.accent-toggle .accent-option { width:0; flex:1 1 0%; height:26px; margin:0; padding:0; display:flex; align-items:center; justify-content:center; border-radius:12px; background:transparent; color:#475569; font-size:13px; font-weight:400; line-height:26px; }.accent-toggle .accent-option.selected { background:#fff; color:#2f6fed; font-weight:700; box-shadow:0 1px 4px #3250a033; }.toggle-switch { width:46px; height:28px; border-radius:14px; background:rgba(120,135,160,.35); position:relative; flex-shrink:0; }.toggle-switch::after { content:''; position:absolute; top:2px; left:2px; width:24px; height:24px; border-radius:50%; background:#fff; box-shadow:0 1px 4px #00000040; transition:transform .15s; }.toggle-switch.enabled { background:#2f6fed; }.toggle-switch.enabled::after { transform:translateX(18px); }.unavailable { color:#64748b; font-size:10px; flex-shrink:0; }.profile-note { text-align:center; font-size:11px; color:#475569; line-height:1.8; }
@media (max-width:350px) { .profile-content { padding-left:12px; padding-right:12px; }.settings-card .setting-row { padding:0 12px; gap:8px; }.setting-title { font-size:13px; }.setting-value { font-size:12px; }.setting-icon { width:28px; height:28px; }.identity-stat { padding-left:4px; padding-right:4px; }.stat-value { font-size:18px; }.accent-toggle { width:100px; flex-basis:100px; } }
