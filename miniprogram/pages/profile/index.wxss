@import '../../styles/glass.wxss';
.profile-page { overflow:hidden; padding-bottom:calc(110px + env(safe-area-inset-bottom)); }.profile-content { display:flex; flex-direction:column; gap:14px; padding:12px 16px; }.identity-card { padding:18px; border-radius:26px; background:rgba(255,255,255,.45); }.identity-row { display:flex; align-items:center; gap:14px; }.avatar { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg,#8fb4ff,#b197fc); border:2px solid #fff; }.avatar image { width:28px; height:28px; }.identity-copy { flex:1; min-width:0; }.nickname { width:100%; height:28px; font-size:18px; font-weight:800; color:#0f172a; background:transparent; padding:0; }.nickname-placeholder { color:#0f172a; }.streak { font-size:12px; color:#475569; margin-top:2px; }.identity-stats { display:flex; margin-top:14px; padding-top:12px; border-top:1px solid rgba(255,255,255,.7); }.identity-stats>view { flex:1; min-width:0; text-align:center; }.identity-stats text { font-size:12px; color:#475569; }.identity-stats>view>view { font-size:20px; font-weight:800; line-height:1.5; overflow-wrap:anywhere; }.identity-stats .xp-value { color:#b45309; }.identity-stats .mastered-value { color:#2f6fed; }
.settings-card { border-radius:22px; overflow:hidden; }.settings-card .setting-row { width:100%; min-width:0; height:54px; margin:0; padding:0 16px; box-sizing:border-box; display:flex; align-items:center; gap:12px; border-radius:0; background:transparent; border-bottom:1px solid rgba(255,255,255,.7); color:#0f172a; text-align:left; font-weight:400; line-height:1.4; }.settings-card .setting-row:last-child { border-bottom:0; }.setting-icon { width:30px; height:30px; border-radius:9px; background:rgba(255,255,255,.7); display:flex; align-items:center; justify-content:center; flex-shrink:0; }.setting-icon image { width:17px; height:17px; }.setting-title { flex:1; min-width:0; font-size:15px; font-weight:600; }.setting-value { display:flex; align-items:center; gap:8px; color:#475569; font-size:14px; flex-shrink:0; }.setting-chevron { width:8px; height:8px; margin-right:3px; border-top:1.5px solid #475569; border-right:1.5px solid #475569; transform:rotate(45deg); flex-shrink:0; }.accent-toggle { display:flex; padding:2px; border-radius:14px; background:rgba(255,255,255,.5); width:106px; flex:0 0 106px; height:30px; }.accent-toggle .accent-option { width:0; flex:1 1 0%; height:26px; margin:0; padding:0; display:flex; align-items:center; justify-content:center; border-radius:12px; background:transparent; color:#475569; font-size:13px; font-weight:400; line-height:26px; }.accent-toggle .accent-option.selected { background:#fff; color:#2f6fed; font-weight:700; box-shadow:0 1px 4px #3250a033; }.toggle-switch { width:46px; height:28px; border-radius:14px; background:rgba(120,135,160,.35); position:relative; flex-shrink:0; }.toggle-switch::after { content:''; position:absolute; top:2px; left:2px; width:24px; height:24px; border-radius:50%; background:#fff; box-shadow:0 1px 4px #00000040; transition:transform .15s; }.toggle-switch.enabled { background:#2f6fed; }.toggle-switch.enabled::after { transform:translateX(18px); }.unavailable { color:#64748b; font-size:10px; flex-shrink:0; }.profile-note { text-align:center; font-size:11px; color:#475569; line-height:1.8; }
@media (max-width:350px) { .profile-content { padding-left:12px; padding-right:12px; }.settings-card .setting-row { padding:0 12px; gap:8px; }.setting-title { font-size:13px; }.setting-value { font-size:12px; }.setting-icon { width:28px; height:28px; }.identity-stats>view>view { font-size:18px; }.accent-toggle { width:100px; flex-basis:100px; } }
