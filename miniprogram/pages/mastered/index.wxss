@import '../../styles/glass.wxss';
.mastered-page { overflow:hidden; padding-bottom:calc(24px + env(safe-area-inset-bottom)); }.mastered-nav { padding-left:10px; font-size:16px; font-weight:700; }
.mastered-summary { display:flex; align-items:center; gap:14px; margin:8px 16px 0; padding:16px 20px; border:1px solid rgba(255,255,255,.85); border-radius:26px; background:linear-gradient(160deg,rgba(47,111,237,.16),rgba(120,160,255,.1)); -webkit-backdrop-filter:blur(24px) saturate(170%); backdrop-filter:blur(24px) saturate(170%); box-shadow:0 8px 28px rgba(50,80,160,.14),inset 0 1px 0 rgba(255,255,255,.9); }.summary-icon { box-sizing:border-box; flex:none; display:flex; align-items:center; justify-content:center; width:48px; height:48px; border:1px solid rgba(255,255,255,.85); border-radius:50%; background:rgba(47,111,237,.16); }.summary-icon image { width:24px; height:24px; }.summary-label { font-size:13px; font-weight:700; color:#475569; }.summary-value { margin-top:2px; color:#2f6fed; font-size:38px; line-height:1.1; font-weight:800; }.summary-value text { margin-left:4px; font-size:15px; }
.mastered-search { box-sizing:border-box; display:flex; align-items:center; gap:8px; height:40px; margin:12px 16px 0; padding:0 14px; border-radius:20px; background:rgba(255,255,255,.45); }.mastered-search image { flex:none; width:18px; height:18px; }.mastered-search input { flex:1; min-width:0; height:100%; color:#0f172a; font-size:14px; }.search-placeholder { color:#64748b; }.filter-scroll { width:100%; margin-top:10px; white-space:nowrap; }.filter-row { display:flex; gap:8px; padding:0 16px; }.filter-row .filter-chip { flex:none; display:flex; align-items:center; justify-content:center; width:auto; height:32px; padding:0 14px; border:1px solid rgba(255,255,255,.8); border-radius:16px; background:rgba(255,255,255,.45); color:#475569; font-size:13px; line-height:30px; }.filter-row .filter-chip.selected { border-color:transparent; background:linear-gradient(135deg,#4f86f7,#2f6fed); color:#fff; font-weight:700; }
.list-heading { display:flex; justify-content:space-between; align-items:baseline; margin:14px 20px 8px; font-size:15px; font-weight:800; }.list-heading text:last-child { color:#475569; font-size:12px; font-weight:400; }.mastered-list { margin:0 16px; border-radius:22px; overflow:hidden; }.mastered-row { display:flex; align-items:center; gap:12px; padding:12px 14px; border-bottom:1rpx solid rgba(255,255,255,.75); }.mastered-row:last-child { border-bottom:0; }.item-copy { flex:1; min-width:0; }.item-english { font-size:17px; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.item-phonetic { margin-left:8px; color:#475569; font-size:12px; font-weight:400; }.item-zh { margin-top:3px; color:#475569; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.mastered-row .read-button { box-sizing:border-box; flex:none; display:flex; align-items:center; justify-content:center; width:36px; height:36px; border:1px solid rgba(255,255,255,.9); border-radius:50%; background:rgba(255,255,255,.7); }.read-button image { width:17px; height:17px; }.list-note { margin:16px; text-align:center; font-size:13px; color:#475569; }.list-note .retry-button { display:inline-block; margin-left:8px; background:transparent; color:#2f6fed; font-size:13px; line-height:1.8; }
.mastered-empty { display:flex; flex-direction:column; align-items:center; margin:14px 16px 0; padding:36px 24px 30px; border-radius:28px; text-align:center; }.empty-icon { display:flex; align-items:center; justify-content:center; width:72px; height:72px; border:1px solid rgba(255,255,255,.85); border-radius:24px; background:rgba(47,111,237,.14); box-shadow:inset 0 1px 0 #fff; }.empty-icon image { width:36px; height:36px; }.empty-title { margin-top:20px; font-size:20px; font-weight:800; }.empty-description { margin-top:10px; color:#475569; font-size:14px; line-height:1.7; }.mastered-empty .learn-button { display:flex; align-items:center; justify-content:center; gap:6px; width:auto; height:50px; margin-top:22px; padding:0 34px; border:1px solid rgba(255,255,255,.85); border-radius:25px; background:rgba(94,234,212,.32); color:#0f766e; font-size:17px; font-weight:800; }.learn-button image { width:18px; height:18px; }
