@import '../../styles/glass.wxss';
.share-page { position:fixed; inset:0; min-height:0; overflow:hidden; }.share-shell { position:relative; display:flex; flex-direction:column; height:100%; }.status-space { flex-shrink:0; }.share-nav { padding-left:10px; font-size:16px; font-weight:700; }.share-nav .back-button { flex:0 0 30px; width:30px; height:36px; background:transparent; color:#0f172a; font-size:32px; font-weight:400; line-height:32px; }.poster-scroll { flex:1; min-height:0; height:0; }.poster-wrapper { position:relative; margin:14px auto 20px; overflow:hidden; border-radius:22px; box-shadow:0 18px 44px rgba(40,70,150,.3); background:#e4edff; }.poster-canvas { display:block; }.poster-status { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; background:rgba(228,237,255,.92); color:#475569; font-size:14px; }.poster-status button { width:auto; padding:10px 16px; color:#2f6fed; background:#fff; border-radius:18px; }.share-actions { flex-shrink:0; padding:20px 20px calc(18px + env(safe-area-inset-bottom)); border-radius:28px 28px 0 0; border-bottom:0; background:rgba(255,255,255,.5); }.action-row { display:flex; gap:12px; }.action-row .share-friend,.action-row .save-image { flex:1 1 0%; width:0; height:50px; padding:0 4px; display:flex; align-items:center; justify-content:center; gap:6px; border-radius:25px; font-size:15px; font-weight:800; white-space:nowrap; }.action-row .share-friend { background:linear-gradient(135deg,#4f86f7,#2f6fed); border:1px solid rgba(255,255,255,.7); box-shadow:0 8px 20px rgba(47,111,237,.35); color:#fff; }.action-row .save-image { background:rgba(255,255,255,.6); border:1px solid rgba(255,255,255,.85); color:#2f6fed; }.action-row button[disabled] { opacity:.5; }.action-row image { width:18px; height:18px; flex-shrink:0; }.share-note { text-align:center; font-size:12px; color:#475569; margin-top:12px; }
@media (max-width:350px) { .share-actions { padding-left:14px; padding-right:14px; }.action-row { gap:8px; }.action-row .share-friend,.action-row .save-image { font-size:13px; } }
