<import src="../../templates/glass.wxml" />
<view class="glass-page stats-page">
  <template is="ambient" />
  <view class="glass-shell">
    <view class="persistent-header {{scrolled ? 'is-scrolled' : ''}}"><view style="height:{{statusBarHeight}}px;"></view><view class="glass-nav" style="height:{{navigationHeight}}px;">学习统计</view></view>
    <view style="height:{{statusBarHeight + navigationHeight}}px;"></view>
    <view class="stats-content">
      <view class="summary-cards">
        <view class="mastery-card glass-surface">
          <view class="summary-heading"><view class="summary-icon mastery-icon"><image src="/assets/library-book-active.svg" /></view><text>已掌握词条</text></view>
          <view class="summary-number">{{completed}}<text class="summary-total">/ {{total}}</text></view>
          <view class="progress-row"><view class="progress-track"><view class="progress-fill" style="width:{{percent}}%;"></view></view><text>{{percent}}%</text></view>
        </view>
        <view class="xp-card">
          <view class="summary-heading"><view class="summary-icon xp-icon"><image src="/assets/glass-xp.svg" /></view><text>经验值</text></view>
          <view class="summary-number">{{xp}}<text class="xp-unit">XP</text></view>
          <view class="xp-spacer"></view>
        </view>
      </view>
      <view class="stat-tiles"><view class="stat-tile glass-surface"><view>输入数</view><text>{{inputCount}}</text></view><view class="stat-tile glass-surface"><view>正确数</view><text class="correct">{{correctCount}}</text></view><view class="stat-tile glass-surface"><view>正确率</view><text>{{accuracy}}</text></view></view>
      <view class="week-card glass-surface"><view class="week-title">本周练习</view><view class="week-chart"><view wx:for="{{week}}" wx:key="key" class="week-day"><view class="bar-area"><view class="week-bar {{item.count ? 'has-activity' : ''}}" style="height:{{item.height}}px;"></view></view><text>{{item.label}}</text></view></view></view>
      <button class="share-button" bindtap="poster">生成分享海报</button>
    </view>
  </view>
</view>
