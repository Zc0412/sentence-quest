@import '../../styles/glass.wxss';
.stats-page { overflow:hidden; padding-bottom:calc(110px + env(safe-area-inset-bottom)); }
.stats-content { display:flex; flex-direction:column; gap:14px; padding:12px 16px; }
.summary-cards { display:flex; gap:10px; }
.mastery-card, .xp-card { box-sizing:border-box; min-width:0; padding:14px 16px 16px; border-radius:22px; }
.mastery-card { flex:1.15; }
.xp-card { flex:1; background:linear-gradient(160deg,rgba(255,226,160,.55),rgba(255,200,120,.3)); -webkit-backdrop-filter:blur(22px) saturate(170%); backdrop-filter:blur(22px) saturate(170%); border:1px solid rgba(255,255,255,.85); box-shadow:0 8px 28px rgba(200,140,40,.16),inset 0 1px 0 rgba(255,255,255,.9); }
.summary-heading { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:700; color:#475569; }
.summary-icon { display:flex; flex:none; align-items:center; justify-content:center; width:28px; height:28px; border-radius:14px; }
.summary-icon image { width:16px; height:16px; }
.mastery-icon { background:rgba(47,111,237,.14); }
.xp-icon { background:rgba(245,158,11,.22); }
.xp-card .summary-heading { color:#92400e; }
.summary-number { margin-top:10px; font-size:36px; font-weight:800; line-height:1; overflow-wrap:anywhere; }
.summary-total { margin-left:4px; font-size:15px; font-weight:400; color:#475569; }
.xp-card .summary-number { color:#78350f; }
.xp-unit { margin-left:4px; font-size:15px; font-weight:700; color:#b45309; }
.progress-row { display:flex; align-items:center; gap:8px; margin-top:12px; }
.progress-track { flex:1; min-width:0; height:6px; border-radius:3px; background:rgba(255,255,255,.75); overflow:hidden; }
.progress-fill { height:6px; border-radius:3px; background:linear-gradient(90deg,#4f86f7,#2f6fed); }
.progress-row text { font-size:12px; font-weight:700; color:#2f6fed; }
.xp-spacer { height:6px; margin-top:12px; }
.stat-tiles { display:flex; gap:10px; }.stat-tile { flex:1; min-width:0; padding:14px 8px; border-radius:18px; text-align:center; }.stat-tile>view { font-size:12px; color:#475569; }.stat-tile>text { display:block; margin-top:2px; font-size:24px; font-weight:800; overflow-wrap:anywhere; }.stat-tile .correct { color:#16a36b; }
.week-card { padding:16px; border-radius:24px; }.week-title { margin-bottom:12px; font-size:15px; font-weight:800; }.week-chart { display:flex; gap:6px; }.week-day { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; gap:6px; }.bar-area { height:90px; display:flex; align-items:flex-end; }.week-bar { width:22px; border-radius:7px; background:rgba(255,255,255,.7); }.week-bar.has-activity { background:linear-gradient(180deg,#4f86f7,#2f6fed); }.week-day>text { font-size:11px; color:#475569; }
.stats-content .share-button { width:100%; height:48px; border:1px solid #ffffff99; border-radius:24px; background:linear-gradient(135deg,#4f86f7,#2f6fed); box-shadow:0 8px 20px #2f6fed59; color:#fff; font-size:16px; font-weight:800; line-height:46px; }
@media (max-width:350px) { .mastery-card, .xp-card { padding-left:12px; padding-right:12px; }.stat-tile { padding-left:4px; padding-right:4px; }.week-chart { gap:4px; }.week-bar { width:19px; } }
