@import '../../styles/glass.wxss';
.stats-page { overflow:hidden; padding-bottom:calc(110px + env(safe-area-inset-bottom)); }.stats-content { display:flex; flex-direction:column; gap:14px; padding:12px 16px; }.mastery-card { display:flex; align-items:center; gap:18px; padding:20px; border-radius:26px; }.mastery-ring { flex-shrink:0; width:86px; height:86px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#ffffffb3; }.mastery-ring>view { width:66px; height:66px; border-radius:50%; background:rgba(255,255,255,.9); display:flex; align-items:center; justify-content:center; font-size:20px; font-weight:800; }.mastery-copy { min-width:0; }.mastery-label { font-size:13px; color:#475569; }.mastery-number { font-size:26px; font-weight:800; }.mastery-number text { font-size:15px; font-weight:500; color:#475569; }.total-xp { margin-top:4px; font-weight:800; font-size:14px; }.total-xp text { color:#f59e0b; font-size:20px; }.stat-tiles { display:flex; gap:10px; }.stat-tile { flex:1; min-width:0; padding:14px 8px; border-radius:18px; text-align:center; }.stat-tile>view { font-size:12px; color:#475569; }.stat-tile>text { display:block; margin-top:2px; font-size:24px; font-weight:800; overflow-wrap:anywhere; }.stat-tile .correct { color:#16a36b; }.week-card { padding:16px; border-radius:24px; }.week-title { margin-bottom:12px; font-size:15px; font-weight:800; }.week-chart { display:flex; gap:6px; }.week-day { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; gap:6px; }.bar-area { height:90px; display:flex; align-items:flex-end; }.week-bar { width:22px; border-radius:7px; background:rgba(255,255,255,.7); }.week-bar.has-activity { background:linear-gradient(180deg,#4f86f7,#2f6fed); }.week-day>text { font-size:11px; color:#475569; }.week-day .today { color:#2f6fed; font-weight:700; }.week-day .day-count { font-size:9px; color:#64748b; }.stats-content .share-button { width:100%; height:48px; border:1px solid #ffffff99; border-radius:24px; background:linear-gradient(135deg,#4f86f7,#2f6fed); box-shadow:0 8px 20px #2f6fed59; color:#fff; font-size:16px; font-weight:800; line-height:46px; }.stats-note { color:#64748b; font-size:10px; line-height:1.7; text-align:center; }
@media (max-width:350px) { .mastery-card { padding:18px 14px; gap:14px; }.stat-tile { padding-left:4px; padding-right:4px; }.week-chart { gap:4px; }.week-bar { width:19px; } }

.total-xp { display:flex; align-items:center; gap:4px; }.total-xp .xp-icon { width:16px; height:16px; }
