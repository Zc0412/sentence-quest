@import '../../styles/glass.wxss';
.review-page { overflow:hidden; padding-bottom:calc(24px + env(safe-area-inset-bottom)); }.review-nav { padding-left:10px; font-size:16px; font-weight:700; }.review-intro { padding:12px 20px 0; font-size:14px; color:#475569; line-height:1.55; }
.review-summary { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:18px 16px 0; padding:18px 20px; border-radius:26px; background:rgba(255,255,255,.45); }.summary-label { font-size:12px; letter-spacing:2px; color:#475569; font-weight:600; }.summary-count { display:flex; align-items:baseline; gap:6px; margin-top:4px; }.summary-count .summary-value { font-size:38px; font-weight:800; line-height:1; }.summary-count .summary-unit { font-size:14px; color:#475569; }.review-summary .start-review { display:flex; align-items:center; justify-content:center; flex:0 0 160px; box-sizing:border-box; width:160px; min-width:0; max-width:100%; height:52px; min-height:52px; margin:0; padding:0 8px; border:1px solid rgba(255,255,255,.6); border-radius:26px; background:linear-gradient(135deg,#4f86f7,#2f6fed); color:#fff; font-size:16px; font-weight:800; line-height:normal; white-space:nowrap; }.review-summary .start-review[disabled] { opacity:1; border-color:rgba(255,255,255,.7); background:rgba(255,255,255,.4); color:#94a3b8; }
.mistakes-list { display:flex; flex-direction:column; gap:10px; margin:16px 16px 0; }.list-heading { font-size:16px; font-weight:800; }.mistake-card { display:flex; align-items:center; gap:10px; padding:12px 14px; border-radius:18px; }.mistake-copy { flex:1; min-width:0; }.mistake-zh { font-size:15px; font-weight:700; line-height:1.5; overflow-wrap:anywhere; }.mistake-english { color:#475569; font-size:13px; line-height:1.5; margin-top:2px; overflow-wrap:anywhere; }.reason-badge { flex-shrink:0; padding:3px 10px; border:1px solid rgba(255,255,255,.7); border-radius:12px; background:rgba(100,116,139,.14); color:#475569; font-size:12px; font-weight:800; white-space:nowrap; }.reason-error { background:rgba(190,18,60,.13); color:#be123c; }.reason-hint { background:rgba(180,83,9,.13); color:#b45309; }.reason-skip { background:rgba(47,111,237,.13); color:#2f6fed; }
.mistake-word-meaning { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.review-empty { display:flex; flex-direction:column; align-items:center; text-align:center; margin:14px 16px 0; padding:34px 24px 30px; border-radius:28px; }.empty-icon { display:flex; align-items:center; justify-content:center; width:72px; height:72px; border-radius:24px; background:rgba(34,197,94,.18); border:1px solid rgba(255,255,255,.85); box-shadow:inset 0 1px 0 #fff; }.empty-icon image { width:38px; height:38px; }.empty-title { font-size:20px; font-weight:800; margin-top:20px; }.empty-description { color:#475569; font-size:14px; line-height:1.7; margin-top:10px; }.review-empty .learn-button { display:flex; align-items:center; justify-content:center; gap:6px; width:auto; height:50px; margin:22px 0 0; padding:0 34px; border:1px solid rgba(255,255,255,.85); border-radius:25px; background:rgba(94,234,212,.32); color:#0f766e; font-size:17px; font-weight:800; }.learn-button image { width:18px; height:18px; }.review-note { text-align:center; font-size:12px; color:#475569; margin:16px 16px 0; }
@media (max-width:350px) { .review-summary { padding:16px 14px; }.review-summary .start-review { flex-basis:150px; width:150px; font-size:14px; }.reason-badge { padding:3px 7px; font-size:11px; } }
