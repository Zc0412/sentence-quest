<view class="page">
  <view class="eyebrow">SENTLEAP · 每天进步一点</view>
  <view class="title">把英语，练成习惯</view>
  <view class="muted">今天已完成 {{today}} 次练习，继续积累吧。</view>
  <view class="hero">
    <view class="hero-label">接着上次的节奏</view>
    <view class="hero-title">{{lastLabel}}</view>
    <button class="resume" bindtap="resume">继续练习 →</button>
  </view>
  <view class="section-title">选择你的练习</view>
  <input class="search" placeholder="搜索题库，如：四级、CET-4" value="{{query}}" bindinput="search" />
  <view class="filters">
    <button class="{{filter === 'all' ? 'selected' : ''}}" data-kind="all" bindtap="filter">全部</button>
    <button class="{{filter === 'word' ? 'selected' : ''}}" data-kind="word" bindtap="filter">单词</button>
    <button class="{{filter === 'phrase' ? 'selected' : ''}}" data-kind="phrase" bindtap="filter">短语 / 句子</button>
  </view>
  <button wx:for="{{lists}}" wx:key="id" class="list-card" data-id="{{item.id}}" bindtap="open">
    <view class="row"><view class="list-title">{{item.label}}</view><text class="pill">{{item.bundled ? '离线可练' : '在线题库'}}</text></view>
    <view class="muted">{{item.category}} · {{item.wordCount}} 题 · 已掌握 {{item.completed}}</view>
  </button>
  <view wx:if="{{!lists.length}}" class="empty muted">没有找到对应题库，换个关键词试试。</view>
</view>
