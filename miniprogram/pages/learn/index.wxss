page { background:#e4edff; }
.library-page { position:relative; min-height:100vh; overflow:hidden; background:linear-gradient(160deg,#e4edff,#eaf8f6); color:#0f172a; font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Helvetica Neue',sans-serif; }
.ambient { position:fixed; inset:0; overflow:hidden; pointer-events:none; }.orb { position:absolute; border-radius:50%; opacity:.85; filter:blur(46px); }.orb-blue { left:-70px; top:40px; width:260px; height:260px; background:#4f86f7; }.orb-purple { left:54%; top:150px; width:200px; height:200px; background:#b197fc; }.orb-mint { left:-40px; top:520px; width:220px; height:220px; background:#6ee7d2; }.orb-teal { left:56%; top:640px; width:240px; height:240px; background:#4fd6c0; }.orb-peach { left:31%; top:300px; width:140px; height:140px; background:#ffd29a; opacity:.7; }
.library-shell { position:relative; padding-bottom:calc(110px + env(safe-area-inset-bottom)); }.library-header { display:flex; align-items:center; gap:8px; padding:0 107px 0 16px; }
.library-content { display:flex; flex-direction:column; gap:14px; padding:12px 16px; }.resume-card { padding:18px; border-radius:26px; background:linear-gradient(135deg,rgba(47,111,237,.88),rgba(110,90,240,.8)); border:1px solid rgba(255,255,255,.5); box-shadow:0 10px 30px rgba(47,111,237,.35),inset 0 1px 0 rgba(255,255,255,.5); color:#fff; }.resume-caption,.resume-description { font-size:12px; line-height:1.5; opacity:.9; }.resume-sentence { margin-top:4px; font-size:20px; font-weight:800; line-height:1.5; overflow-wrap:break-word; }.resume-description { margin-top:2px; }.resume-card .resume-button { width:auto; min-width:0; margin-left:0; margin-right:0; display:inline-block; margin-top:14px; height:44px; line-height:44px; padding:0 22px; border-radius:22px; background:rgba(255,255,255,.92); color:#2f6fed; font-size:15px; font-weight:800; }
.glass { background:rgba(255,255,255,.42); -webkit-backdrop-filter:blur(22px) saturate(170%); backdrop-filter:blur(22px) saturate(170%); border:1px solid rgba(255,255,255,.8); box-shadow:0 8px 28px rgba(50,80,160,.14),inset 0 1px 0 rgba(255,255,255,.9); }.library-section { width:100%; min-width:0; display:flex; align-items:center; justify-content:space-between; gap:12px; }.library-title { font-size:17px; font-weight:800; }/* Explicitly override native v2 button width, auto margins and padding. */
.library-content .library-card { display:flex; align-self:stretch; width:100%; min-width:0; max-width:100%; height:auto; min-height:0; margin:0; box-sizing:border-box; align-items:center; gap:14px; padding:14px 16px; border-radius:20px; text-align:left; color:#0f172a; line-height:1.5; font-weight:400; }.library-icon { flex-shrink:0; width:44px; height:44px; border-radius:13px; background:linear-gradient(135deg,#8fb4ff,#4f86f7); box-shadow:inset 0 1px 0 rgba(255,255,255,.7); }.mint-icon { background:linear-gradient(135deg,#9cf0df,#4fd6c0); }.library-copy { flex:1; min-width:0; }.library-name { font-size:16px; font-weight:700; }.library-meta { margin-top:2px; color:#475569; font-size:12px; }.library-track { margin-top:8px; height:5px; border-radius:3px; background:rgba(255,255,255,.7); overflow:hidden; }.library-fill { height:100%; border-radius:3px; background:#2f6fed; }.chevron { flex-shrink:0; width:10px; height:10px; margin-right:3px; border-top:2px solid #475569; border-right:2px solid #475569; transform:rotate(45deg); }
@media (max-width:350px) { .library-header { padding-right:96px; }.library-content { padding-left:12px; padding-right:12px; }.library-content .library-card { gap:10px; padding:14px; } }
.brand-image { width:92px; height:34px; flex-shrink:0; display:block; }
.welcome-card { padding:20px 18px 18px; border-radius:28px; background:rgba(255,255,255,.45); }
.welcome-title { font-size:22px; font-weight:800; line-height:1.4; }.welcome-description { font-size:13px; color:#475569; margin-top:4px; }
.welcome-example { margin-top:14px; padding:12px 8px 10px; border-radius:18px; background:rgba(255,255,255,.5); border:1px solid rgba(255,255,255,.8); text-align:center; }.example-prompt { font-size:14px; font-weight:700; margin-bottom:8px; }.example-board { display:flex; flex-wrap:wrap; justify-content:center; gap:4px 0; }.example-word { padding:0 3px; }.example-pending { opacity:.55; }.example-phonetic { font-size:10px; color:#475569; text-align:center; white-space:nowrap; margin-bottom:2px; }.example-active .example-phonetic { color:#2f6fed; }.example-letters { display:flex; justify-content:center; }.example-letter { width:12px; height:24px; display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700; color:#0f172a; }.example-passed .example-letter { color:#16a36b; }.example-dot { width:5px; height:5px; border-radius:2px; background:rgba(100,116,139,.5); }.example-underline { height:3px; border-radius:2px; margin-top:2px; background:rgba(47,111,237,.3); }.example-passed .example-underline { background:#16a36b; }.example-active .example-underline { background:linear-gradient(90deg,#4f86f7,#2f6fed); box-shadow:0 2px 8px rgba(47,111,237,.55); }
.welcome-steps { display:flex; gap:6px; margin-top:14px; }.welcome-steps>view { flex:1; min-width:0; text-align:center; }.welcome-steps>view>text { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:11px; background:rgba(47,111,237,.15); color:#2f6fed; font-size:12px; font-weight:800; }.welcome-steps>view>view { font-size:12px; color:#475569; margin-top:4px; line-height:1.4; }.welcome-card .first-button { display:flex; align-items:center; justify-content:center; gap:6px; box-sizing:border-box; width:100%; min-width:0; height:52px; margin:16px 0 0; padding:0; border:1px solid rgba(255,255,255,.6); border-radius:26px; background:linear-gradient(135deg,#4f86f7,#2f6fed); color:#fff; font-size:17px; font-weight:800; line-height:normal; }.first-button image { width:18px; height:18px; }.welcome-caption { text-align:center; font-size:12px; color:#475569; margin-top:10px; }.start-pill { flex-shrink:0; padding:5px 12px; border-radius:14px; background:#2f6fed; color:#fff; font-size:12px; font-weight:800; }.not-started { flex-shrink:0; font-size:12px; color:#475569; }

.library-section .all-libraries { display:flex; align-items:center; justify-content:center; gap:2px; width:auto; min-width:0; margin:0; padding:6px 0 6px 12px; background:transparent; color:#2f6fed; font-size:14px; font-weight:700; line-height:20px; white-space:nowrap; }.all-libraries text { display:block; line-height:20px; }.all-libraries image { display:block; flex-shrink:0; width:16px; height:16px; }.no-recent { text-align:center; padding:20px 12px; font-size:12px; color:#475569; }
