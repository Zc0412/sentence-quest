.hero { margin:32rpx 0; padding:36rpx; border-radius:32rpx; background:linear-gradient(125deg,#2563eb,#5189f5); color:white; }
.hero-label { font-size:24rpx; opacity:.8; }.hero-title { margin:18rpx 0 32rpx; font-size:40rpx; font-weight:750; }
.resume { background:white; color:#2563eb; font-weight:700; line-height:88rpx; }
.search { background:white; padding:24rpx; height:88rpx; border-radius:22rpx; }
.filters { display:flex; gap:16rpx; margin:24rpx 0; }.filters button { flex:1; padding:0 8rpx; font-size:25rpx; line-height:80rpx; background:#eaf0f8; color:#64748b; }.filters .selected { background:#dbeafe; color:#2563eb; font-weight:700; }
.list-card { text-align:left; margin-bottom:18rpx; padding:28rpx; background:#fff; color:#17243b; line-height:1.6; border:1rpx solid #e9eef7; }.list-title { font-size:30rpx; font-weight:700; }.list-card .muted { margin-top:12rpx; }
