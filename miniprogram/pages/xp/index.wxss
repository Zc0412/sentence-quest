@import '../../styles/glass.wxss';
.xp-page { overflow:hidden; padding-bottom:calc(24px + env(safe-area-inset-bottom)); }.xp-nav { padding-left:10px; font-size:16px; font-weight:700; }
.xp-summary { display:flex; align-items:center; gap:16px; margin:8px 16px 0; padding:18px 20px; border:1px solid rgba(255,255,255,.85); border-radius:28px; background:linear-gradient(160deg,rgba(255,226,160,.6),rgba(255,200,120,.32)); -webkit-backdrop-filter:blur(24px) saturate(170%); backdrop-filter:blur(24px) saturate(170%); box-shadow:0 8px 28px rgba(200,140,40,.18),inset 0 1px 0 rgba(255,255,255,.9); }.summary-icon { box-sizing:border-box; flex:none; display:flex; align-items:center; justify-content:center; width:56px; height:56px; border:1px solid rgba(255,255,255,.8); border-radius:50%; background:rgba(245,158,11,.24); }.summary-icon image { width:28px; height:28px; }.summary-copy { flex:1; min-width:0; }.summary-title { font-size:13px; font-weight:700; color:#92400e; }.summary-value { margin-top:2px; font-size:44px; font-weight:800; line-height:1.1; color:#78350f; overflow-wrap:anywhere; }.summary-value text { margin-left:4px; font-size:16px; color:#b45309; }.today-xp { flex:none; padding:5px 10px; border:1px solid rgba(255,255,255,.9); border-radius:14px; background:rgba(255,255,255,.6); font-size:12px; font-weight:800; color:#b45309; }
.xp-tabs { box-sizing:border-box; display:flex; height:42px; margin:14px 16px 0; padding:3px; border-radius:18px; background:rgba(255,255,255,.4); }.xp-tabs .xp-tab { display:flex; flex:1; align-items:center; justify-content:center; width:0; height:34px; border-radius:15px; background:transparent; color:#475569; font-size:14px; font-weight:600; }.xp-tabs .xp-tab.selected { background:#fff; box-shadow:0 1px 6px rgba(50,80,160,.22); color:#2f6fed; font-weight:800; }
.detail-group { margin:14px 16px 0; }.group-heading { display:flex; justify-content:space-between; align-items:baseline; margin:0 4px 8px; font-size:15px; font-weight:800; }.group-heading text:last-child { font-size:12px; color:#b45309; }.xp-list { border-radius:22px; overflow:hidden; }.rules-list { margin:14px 16px 0; }.xp-row { display:flex; align-items:center; gap:12px; padding:12px 14px; border-bottom:1rpx solid rgba(255,255,255,.75); }.xp-row:last-child { border-bottom:0; }.row-icon { box-sizing:border-box; display:flex; flex:none; align-items:center; justify-content:center; width:36px; height:36px; border:1px solid rgba(255,255,255,.8); border-radius:50%; }.row-icon image { width:18px; height:18px; }.icon-green { background:#16a36b22; }.icon-gold { background:#f59e0b22; }.row-copy { flex:1; min-width:0; }.row-title { font-size:15px; font-weight:700; }.row-description { margin-top:2px; color:#475569; font-size:12px; overflow-wrap:anywhere; }.row-amount { flex:none; color:#b45309; font-size:16px; font-weight:800; white-space:nowrap; }.row-amount text { margin-left:2px; font-size:11px; }
.rules-note,.xp-empty { margin:14px 16px 0; padding:14px 16px; border-radius:22px; }.note-heading { display:flex; align-items:center; gap:8px; font-size:15px; font-weight:800; }.note-heading image { width:18px; height:18px; }.note-content { margin-top:8px; white-space:pre-wrap; font-size:13px; color:#475569; line-height:1.7; }.xp-empty { text-align:center; font-size:14px; line-height:1.6; color:#475569; }.history-note { margin:14px 20px; color:#64748b; font-size:11px; line-height:1.6; }
@media (max-width:350px) { .xp-summary { gap:8px; padding:16px 12px; }.summary-icon { width:48px; height:48px; }.summary-value { font-size:36px; }.today-xp { padding:5px 6px; font-size:11px; } }
