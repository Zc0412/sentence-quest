<import src="../../templates/glass.wxml" />
<view class="glass-page library-all">
  <template is="ambient" />
  <view class="library-all-shell">
    <view style="height:{{statusBarHeight}}px;" class="status-space"></view>
    <view class="glass-nav all-nav" style="height:{{navigationHeight}}px;"><button class="back-button" bindtap="back" aria-label="返回题库"><image src="/assets/practice-back.svg" /></button><view>全部题库</view></view>
    <view class="all-tools">
      <view class="kind-tabs glass-surface"><button class="kind-button {{kind === 'phrase' ? 'active' : ''}}" data-kind="phrase" bindtap="chooseKind">短语库 <text>{{phraseCount}}</text></button><button class="kind-button {{kind === 'word' ? 'active' : ''}}" data-kind="word" bindtap="chooseKind">单词库 <text>{{wordCount}}</text></button></view>
      <view class="search-box glass-surface"><image src="/assets/library-search.svg" /><input class="search-input" type="text" placeholder="搜索题库名称" value="{{query}}" bindinput="search" confirm-type="search" /><button wx:if="{{query}}" class="clear-search" bindtap="clearSearch" aria-label="清除搜索">×</button></view>
    </view>
    <view class="all-body">
      <scroll-view scroll-y class="filter-scroll glass-surface"><view class="filter-content"><block wx:for="{{filters}}" wx:key="id"><view wx:if="{{index === 3}}" class="filter-divider"></view><button class="filter-button {{filter === item.id ? 'active' : ''}}" data-filter="{{item.id}}" bindtap="chooseFilter">{{item.label}}</button></block></view></scroll-view>
      <view class="results"><view class="results-heading"><text>{{filterLabel}}</text><text>共 {{lists.length}} 个</text></view><scroll-view scroll-y class="results-scroll"><view class="results-list"><button wx:for="{{lists}}" wx:key="id" class="result-card glass-surface" data-id="{{item.id}}" bindtap="open"><view class="result-icon color-{{item.colorIndex}}"></view><view class="result-copy"><view class="result-row"><view class="result-name">{{item.label}}</view><text class="result-status {{item.started ? 'started' : ''}}">{{item.completed === item.wordCount ? '已掌握' : item.started ? '进行中' : '未开始'}}</text></view><view class="result-meta">{{item.wordCount}} {{item.kind === 'word' ? '词' : '句'}} · {{item.started ? '已掌握 ' + item.completed : '尚未开始'}}</view><view class="result-track"><view style="width:{{item.percent}}%;"></view></view></view></button><view wx:if="{{!lists.length}}" class="no-results">{{query ? '没有找到相关题库' : filter === 'recent' ? '暂无最近练习' : filter === 'progress' ? '暂无进行中的题库' : '暂无题库'}}</view></view></scroll-view></view>
    </view>
  </view>
</view>
