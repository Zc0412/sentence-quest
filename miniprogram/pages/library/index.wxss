@import '../../styles/glass.wxss';
.library-all { position:fixed; inset:0; min-height:0; overflow:hidden; }.library-all-shell { position:relative; height:100%; display:flex; flex-direction:column; }.status-space { flex-shrink:0; }.all-nav { font-size:16px; font-weight:700; padding-left:10px; }.all-nav .back-button { display:flex; align-items:center; justify-content:center; flex:0 0 30px; width:30px; height:36px; background:transparent; }.back-button image { width:22px; height:22px; }
.all-tools { padding:8px 16px 0; display:flex; flex-direction:column; gap:10px; flex-shrink:0; }.kind-tabs { display:flex; padding:3px; border-radius:18px; height:42px; }.kind-tabs .kind-button { flex:1 1 0%; width:0; height:34px; display:flex; align-items:center; justify-content:center; gap:6px; border-radius:15px; background:transparent; color:#475569; font-size:14px; font-weight:600; }.kind-tabs .kind-button.active { background:#fff; color:#2f6fed; font-weight:800; box-shadow:0 1px 6px rgba(50,80,160,.22); }.kind-button text { font-size:12px; opacity:.7; }.search-box { display:flex; align-items:center; gap:8px; height:40px; padding:0 14px; border-radius:20px; }.search-box image { flex-shrink:0; width:18px; height:18px; }.search-input { flex:1; min-width:0; height:38px; font-size:14px; background:transparent; }.search-box .clear-search { flex:0 0 26px; width:26px; height:26px; background:transparent; color:#64748b; font-size:20px; }
.all-body { flex:1; min-height:0; display:flex; gap:8px; padding:12px 16px calc(16px + env(safe-area-inset-bottom)); }.filter-scroll { flex:0 0 88px; width:88px; height:100%; border-radius:20px; background:rgba(255,255,255,.35); }.filter-content { padding:6px; }.filter-content .filter-button { position:relative; display:block; width:100%; margin:0; padding:12px 4px 12px 8px; border-radius:14px; background:transparent; color:#475569; text-align:left; font-size:13px; font-weight:400; line-height:20px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.filter-content .filter-button.active { background:rgba(255,255,255,.85); color:#2f6fed; box-shadow:0 2px 8px rgba(50,80,160,.18); font-weight:800; }.filter-content .filter-button.active::before { content:''; position:absolute; left:0; top:12px; bottom:12px; width:3px; border-radius:2px; background:#2f6fed; }.filter-divider { height:1px; margin:6px 10px; background:rgba(255,255,255,.8); }
.results { display:flex; flex:1; min-width:0; min-height:0; flex-direction:column; gap:10px; }.results-heading { display:flex; align-items:baseline; justify-content:space-between; gap:8px; flex-shrink:0; font-size:15px; font-weight:800; }.results-heading text:last-child { font-size:12px; font-weight:400; color:#475569; white-space:nowrap; }.results-scroll { flex:1; height:0; min-height:0; }.results-list { display:flex; flex-direction:column; gap:10px; padding-bottom:12px; }.results-list .result-card { display:flex; align-items:center; gap:10px; box-sizing:border-box; width:100%; min-width:0; margin:0; padding:11px 12px; text-align:left; border-radius:18px; color:#0f172a; font-weight:400; line-height:1.4; }.result-icon { flex-shrink:0; width:38px; height:38px; border-radius:11px; background:linear-gradient(135deg,#8fb4ff,#4f86f7); box-shadow:inset 0 1px 0 rgba(255,255,255,.7); }.result-icon.color-1 { background:linear-gradient(135deg,#9cf0df,#4fd6c0); }.result-icon.color-2 { background:linear-gradient(135deg,#ffd29a,#ffb36b); }.result-icon.color-3 { background:linear-gradient(135deg,#d4c2ff,#b197fc); }.result-icon.color-4 { background:linear-gradient(135deg,#ffb8c8,#ff8fa8); }.result-icon.color-5 { background:linear-gradient(135deg,#9ad9ff,#4fb0f0); }.result-copy { flex:1; min-width:0; }.result-row { display:flex; justify-content:space-between; align-items:center; gap:6px; }.result-name { min-width:0; font-weight:800; font-size:15px; overflow-wrap:anywhere; }.result-status { flex-shrink:0; font-size:11px; color:#475569; }.result-status.started { color:#2f6fed; font-weight:800; }.result-meta { margin-top:1px; font-size:12px; color:#475569; }.result-track { margin-top:6px; height:4px; border-radius:2px; background:rgba(255,255,255,.75); overflow:hidden; }.result-track>view { height:100%; border-radius:2px; background:#2f6fed; }.no-results { text-align:center; color:#64748b; padding:32px 8px; font-size:12px; line-height:1.6; }
@media (max-width:350px) { .all-tools { padding-left:12px; padding-right:12px; }.all-body { padding-left:12px; padding-right:12px; }.filter-scroll { flex-basis:78px; width:78px; }.filter-content .filter-button { padding-left:8px; font-size:12px; }.results-list .result-card { padding:10px 8px; gap:8px; }.result-name { font-size:14px; }.result-meta { font-size:11px; } }
