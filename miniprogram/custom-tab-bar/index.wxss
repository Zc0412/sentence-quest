:host { font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif; }
.glass-tabs { box-sizing:border-box; position:fixed; z-index:5; left:24px; right:24px; bottom:calc(12px + env(safe-area-inset-bottom)); display:flex; padding:6px; border-radius:28px; background:rgba(255,255,255,.5); -webkit-backdrop-filter:blur(26px) saturate(170%); backdrop-filter:blur(26px) saturate(170%); border:1px solid rgba(255,255,255,.8); box-shadow:0 8px 28px rgba(50,80,160,.14),inset 0 1px 0 rgba(255,255,255,.9); }
.glass-tabs .glass-tab { box-sizing:border-box; flex:1 1 0%; width:0; min-width:0; min-height:0; height:48px; margin:0; padding:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; border:0; border-radius:22px; background:transparent; color:#475569; font-size:11px; font-weight:500; line-height:16px; }
.glass-tab::after { border:0; }
.glass-tabs .glass-tab { position:relative; z-index:1; }
.glass-tabs .glass-tab.active { color:#2f6fed; font-weight:700; background:rgba(255,255,255,.8); box-shadow:0 2px 8px rgba(50,80,160,.18); }
.glass-tab image { width:22px; height:22px; }
