page { background:#e4edff; }
.glass-page { position:relative; min-height:100vh; background:linear-gradient(160deg,#e4edff,#eaf8f6); color:#0f172a; font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif; }
.ambient { position:fixed; inset:0; overflow:hidden; pointer-events:none; }.orb { position:absolute; border-radius:50%; opacity:.85; filter:blur(46px); }.orb-blue { left:-70px; top:40px; width:260px; height:260px; background:#4f86f7; }.orb-purple { left:54%; top:150px; width:200px; height:200px; background:#b197fc; }.orb-mint { left:-40px; top:520px; width:220px; height:220px; background:#6ee7d2; }.orb-teal { left:56%; top:640px; width:240px; height:240px; background:#4fd6c0; }.orb-peach { left:31%; top:300px; width:140px; height:140px; background:#ffd29a; opacity:.7; }

.glass-surface { background:rgba(255,255,255,.42); -webkit-backdrop-filter:blur(22px) saturate(170%); backdrop-filter:blur(22px) saturate(170%); border:1px solid rgba(255,255,255,.8); box-shadow:0 8px 28px rgba(50,80,160,.14),inset 0 1px 0 rgba(255,255,255,.9); }
.glass-shell { position:relative; }.glass-nav { display:flex; align-items:center; padding:0 107px 0 16px; gap:6px; flex-shrink:0; font-size:18px; font-weight:800; }.glass-nav-title { min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.glass-page button { box-sizing:border-box; min-width:0; min-height:0; width:auto; height:auto; margin:0; padding:0; line-height:normal; }.glass-page button::after { border:0; }

/* The icon and title form one native button so both return to the previous page. */
.glass-nav .nav-back { display:flex; align-items:center; gap:6px; width:auto; min-width:0; max-width:100%; height:36px; margin:0; padding:0; background:transparent; color:#0f172a; font-size:16px; font-weight:700; line-height:normal; text-align:left; }
.nav-back-icon { display:flex; flex:0 0 30px; width:30px; height:36px; align-items:center; justify-content:center; }
.nav-back-icon image { width:22px; height:22px; }
.nav-back-icon.back-glyph { font-size:32px; font-weight:400; line-height:32px; }

.modal-overlay { position:fixed; z-index:999; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:20px; box-sizing:border-box; background:rgba(15,23,42,.3); -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px); }
.modal-card { box-sizing:border-box; width:312px; max-width:100%; max-height:90vh; display:flex; flex-direction:column; padding:24px 22px 20px; border:1px solid rgba(255,255,255,.92); border-radius:30px; background:rgba(255,255,255,.66); -webkit-backdrop-filter:blur(30px) saturate(180%); backdrop-filter:blur(30px) saturate(180%); box-shadow:0 24px 60px rgba(30,50,110,.35),inset 0 1px 0 #fff; }
.modal-heading { display:flex; align-items:center; justify-content:center; gap:8px; flex:none; color:#0f172a; font-size:19px; font-weight:800; }.modal-title-icon { display:flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:50%; background:rgba(47,111,237,.14); }.modal-title-icon image { width:17px; height:17px; }
.modal-body { min-height:0; margin-top:18px; }.help-rows { display:flex; flex-direction:column; gap:14px; }.help-row { display:flex; align-items:flex-start; gap:10px; color:#1e293b; font-size:14px; line-height:1.6; }.help-row text { flex:1; min-width:0; }.modal-help-icon { box-sizing:border-box; flex:none; display:flex; align-items:center; justify-content:center; width:28px; height:28px; margin-top:1px; border:1px solid rgba(255,255,255,.8); border-radius:50%; }.modal-help-icon image { width:15px; height:15px; }.help-blue { background:#2f6fed22; }.help-teal { background:#0f9d8a22; }.help-red { background:#be123c22; }.help-gold { background:#b4530922; }.modal-message { white-space:pre-wrap; color:#1e293b; font-size:14px; line-height:1.6; overflow-wrap:anywhere; }
.modal-actions { display:flex; gap:10px; flex:none; margin-top:22px; }.modal-actions button { box-sizing:border-box; flex:1; width:0; min-width:0; height:48px; margin:0; padding:0 8px; border:1px solid rgba(255,255,255,.7); border-radius:24px; font-size:17px; font-weight:800; line-height:46px; }.modal-actions button::after { border:0; }.modal-actions .modal-confirm { background:linear-gradient(135deg,#4f86f7,#2f6fed); color:#fff; }.modal-actions .modal-cancel { background:rgba(255,255,255,.55); color:#475569; }
